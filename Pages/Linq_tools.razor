@page "/linq_tools"
@using System.Collections.Generic
@inject IJSRuntime JS

<PageTitle>LINQ Performance Testing</PageTitle>

<div class="container-fluid py-4 px-5 bg-light min-vh-100">
    <h3 class="fw-bold mb-2">LINQ Performance Testing</h3>
    <p class="text-muted small mb-4">
        This is a page where you can build your own C# object and test LINQ performance on it.<br />
        (Performance numbers may be skewed by WASM overhead — treat as rough estimates.)
    </p>

    <!-- File Tabs -->
    <div class="d-flex align-items-center">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active" href="#">MyClass1.cs</a>
            </li>
        </ul>
    </div>

    <!-- Object Builder Table -->
    <div class="bg-white rounded shadow-sm p-4 mb-3">
        <div class="row fw-bold border-bottom pb-2 mb-2">
            <div class="col-2">Type</div>
            <div class="col-3">Name</div>
            <div class="col-4 text-end">Actions</div>
        </div>

        @foreach (var prop in Properties)
        {
            <div class="row align-items-center mb-2">
                <div class="col-2">
                    <select class="form-select form-select-sm" @bind="prop.Type">
                        @foreach (var type in Enum.GetValues<DataType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div class="col-3">
                    <input class="form-control form-control-sm" @bind="prop.Name" placeholder="Id" />
                </div>
                <div class="col-4 text-end">
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => Delete(prop)">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </div>
        }

        <div class="text-start mt-3">
            <button class="btn btn-success btn-sm" @onclick="AddProperty">
                <i class="bi bi-plus-circle"></i> Add Property
            </button>
        </div>
    </div>

    <div class="mb-3">
        <div class="d-flex align-items-center gap-2 mb-3">
            <input type="number" class="form-control w-auto" @bind="Amount" min="1" placeholder="Amount" />
        </div>
    </div>

    <!-- LINQ Expression + Amount + Test -->
    <div class="mb-3">
        <label class="form-label fw-bold">
            LINQ Expression
            <span class="d-inline-block ms-1" tabindex="0"
                  data-bs-toggle="tooltip" data-bs-html="true"
                  title="&lt;b&gt;Example queries:&lt;/b&gt;&lt;br&gt;
                         &lt;code&gt;.Where(Id &amp;gt; 500)&lt;/code&gt;&lt;br&gt;
                         &lt;code&gt;.Where(Id &amp;gt; 100 &amp;amp;&amp;amp; Id &amp;lt; 900)&lt;/code&gt;&lt;br&gt;
                         &lt;code&gt;.OrderBy(Id).Take(10)&lt;/code&gt;&lt;br&gt;
                         &lt;code&gt;.Where(Name.Contains(&amp;quot;ab&amp;quot;))&lt;/code&gt;&lt;br&gt;
                         &lt;code&gt;.Select(Id, Name)&lt;/code&gt;&lt;br&gt;
                         &lt;code&gt;.Where(Id &amp;gt; 50).OrderByDescending(Id).Take(5)&lt;/code&gt;&lt;br&gt;
                         &lt;code&gt;.Count()&lt;/code&gt;&lt;br&gt;
                         &lt;code&gt;.Skip(10).Take(5)&lt;/code&gt;&lt;br&gt;
                         &lt;b&gt;Operators:&lt;/b&gt; ==, !=, &amp;gt;, &amp;lt;, &amp;gt;=, &amp;lt;=, &amp;amp;&amp;amp;, ||&lt;br&gt;
                         &lt;b&gt;Methods:&lt;/b&gt; Where, OrderBy, OrderByDescending, Select, Take, Skip, Count, First, Any, Distinct, Reverse">
                <i class="bi bi-question-circle text-primary" style="cursor: help;"></i>
            </span>
        </label>
        <input class="form-control mb-2" @bind="LinqExpression" placeholder=".Where(Id > 500).OrderBy(Id).Take(10)" />

        <div class="d-flex align-items-center gap-2 mb-3">
            <button class="btn btn-success" @onclick="Test">
                Test
            </button>
        </div>
    </div>

    <!-- Results Section -->
    <div class="bg-white rounded shadow-sm p-4">
        <h5 class="fw-bold mb-3">Results</h5>

        @if (Results == null)
        {
            <p class="text-muted">No test results yet. Enter an expression and click Test.</p>
        }
        else if (!string.IsNullOrEmpty(Results.Error))
        {
            <div class="alert alert-danger">
                <strong>Error:</strong> @Results.Error
            </div>
        }
        else
        {
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="card border-0 bg-light">
                        <div class="card-body py-2">
                            <h6 class="card-title fw-bold mb-2">Query Info</h6>
                            <p class="mb-1"><strong>Expression:</strong> <code>@Results.Expression</code></p>
                            <p class="mb-1"><strong>Generated Objects:</strong> @Results.Amount.ToString("N0")</p>
                            <p class="mb-0"><strong>Result Count:</strong> @Results.ResultCount.ToString("N0")</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 bg-light">
                        <div class="card-body py-2">
                            <h6 class="card-title fw-bold mb-2">Performance</h6>
                            <p class="mb-1"><strong>Data Generation:</strong> @Results.DataGenerationTime ms</p>
                            <p class="mb-1"><strong>Query Execution:</strong> @Results.ExecutionTime ms <span class="text-muted small">(@Results.ExecutionTimeMicroseconds µs)</span></p>
                            <p class="mb-0"><strong>Total:</strong> @(Results.DataGenerationTime + Results.ExecutionTime) ms</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="card border-0 bg-light">
                        <div class="card-body py-2 text-center">
                            <small class="text-muted">Throughput</small>
                            <p class="mb-0 fw-bold">@Results.ItemsPerMs.ToString("N1") items/ms</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 bg-light">
                        <div class="card-body py-2 text-center">
                            <small class="text-muted">Filter Rate</small>
                            <p class="mb-0 fw-bold">@Results.FilterPercentage%</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 bg-light">
                        <div class="card-body py-2 text-center">
                            <small class="text-muted">Memory Used</small>
                            <p class="mb-0 fw-bold">@FormatBytes(Results.MemoryUsed)</p>
                        </div>
                    </div>
                </div>
            </div>

            @if (Results.ResultData.Count > 0)
            {
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-sm table-striped table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                @foreach (var col in Results.ResultData[0].Keys)
                                {
                                    <th>@col</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Results.ResultData.Count && i < MaxDisplayRows; i++)
                            {
                                var row = Results.ResultData[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    @foreach (var val in row.Values)
                                    {
                                        <td>@FormatValue(val)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Results.ResultData.Count > MaxDisplayRows)
                {
                    <p class="text-muted small">Showing first @MaxDisplayRows of @Results.ResultData.Count results.</p>
                }
            }
        }
    </div>
</div>

@code {
    private string LinqExpression { get; set; } = string.Empty;
    private int Amount { get; set; } = 10;
    private const int MaxDisplayRows = 200;
    private bool _tooltipsInitialized;

    private List<LinqProperty> Properties = new()
    {
        new LinqProperty { Type = DataType.Int, Name = "Id", Value = "1" }
    };

    private LinqResult? Results { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tooltipsInitialized)
        {
            await JS.InvokeVoidAsync("initTooltips");
            _tooltipsInitialized = true;
        }
    }

    private void AddProperty() => Properties.Add(new LinqProperty { Type = DataType.String });

    private void Delete(LinqProperty prop) => Properties.Remove(prop);

    private void Test()
    {
        if (Amount < 1)
        {
            Results = new LinqResult
            {
                Expression = LinqExpression,
                Amount = Amount,
                Error = "Amount must be at least 1."
            };
            return;
        }

        if (string.IsNullOrWhiteSpace(LinqExpression))
        {
            Results = new LinqResult
            {
                Expression = "(empty)",
                Amount = Amount,
                Error = "Please enter a LINQ expression. Example: .Where(it[\"Age\"] > 30)"
            };
            return;
        }

        // Validate all properties have names
        var validProps = Properties.Where(p => !string.IsNullOrWhiteSpace(p.Name)).ToList();
        if (validProps.Count == 0)
        {
            Results = new LinqResult
            {
                Expression = LinqExpression,
                Amount = Amount,
                Error = "Define at least one property with a name."
            };
            return;
        }

        var genSw = System.Diagnostics.Stopwatch.StartNew();
        var items = DataGenerator.GenerateItems(validProps, Amount);
        genSw.Stop();

        Results = LinqExecutor.Execute(items, LinqExpression, validProps);
        Results.DataGenerationTime = genSw.ElapsedMilliseconds;
    }

    private string FormatValue(object? val)
    {
        if (val == null) return "null";
        if (val is DateTime dt) return dt.ToString("yyyy-MM-dd HH:mm");
        return val.ToString() ?? "null";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 0) return "N/A";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }
}
